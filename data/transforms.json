  {"first": "We had hardly started when the power went off.", "key": "SOONER", "stem": "No ___ than the power went off.", "chunks": [["sooner had"], ["we started"]], "answer": "sooner had we started", "hint": "No sooner + past perfect inversion + than.", "tags": ["transformation", "inversion"]},
