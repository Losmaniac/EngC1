  {"first": "I regret not taking the job in Prague.", "key": "WISH", "stem": "I ___ the job in Prague.", "chunks": [["wish i had", "wish i'd"], ["taken"]], "answer": "wish I had taken", "hint": "wish + past perfect for past regrets.", "tags": ["transformation", "tense"]},
