  {"first": "If it hadn't been for your help, we would have failed.", "key": "BUT", "stem": "We would have failed ___ help.", "chunks": [["but for"], ["your"]], "answer": "but for your", "hint": "But for = if it hadn't been for.", "tags": ["transformation", "conditional"]},
  {"first": "The meeting was postponed because the director was ill.", "key": "OWING", "stem": "The meeting was postponed ___ illness.", "chunks": [["owing to"], ["the director's"]], "answer": "owing to the director's", "hint": "owing to + noun phrase.", "tags": ["transformation", "linker"]},
  {"first": "They're going to announce the results next week.", "key": "DUE", "stem": "The results ___ next week.", "chunks": [["are due"], ["to be announced"]], "answer": "are due to be announced", "hint": "be due to + passive infinitive.", "tags": ["transformation", "passive"]},
  {"first": "I'd prefer you not to tell anyone yet.", "key": "RATHER", "stem": "I'd ___ anyone yet.", "chunks": [["rather you"], ["didn't tell", "did not tell"]], "answer": "rather you didn't tell", "hint": "would rather + subject + past simple.", "tags": ["transformation", "subjunctive"]},
  {"first": "It was wrong of you to sign without asking me.", "key": "OUGHT", "stem": "You ___ without asking me.", "chunks": [["ought not to", "oughtn't to"], ["have signed"]], "answer": "ought not to have signed", "hint": "Criticism of the past: modal + have + past participle.", "tags": ["transformation", "modal"]},
  {"first": "The minister's resignation surprised everyone.", "key": "CAME", "stem": "The minister's resignation ___ everyone.", "chunks": [["came as a surprise"], ["to"]], "answer": "came as a surprise to", "hint": "come as a surprise to someone.", "tags": ["transformation", "collocation"]},
  {"first": "It's ages since I last spoke to her.", "key": "FOR", "stem": "I ___ ages.", "chunks": [["haven't spoken", "have not spoken"], ["to her for"]], "answer": "haven't spoken to her for", "hint": "Present perfect negative + for.", "tags": ["transformation", "tense"]},
  {"first": "The project is not likely to be finished on time.", "key": "CHANCE", "stem": "There is ___ the project being finished on time.", "chunks": [["little chance", "not much chance", "small chance", "slim chance"], ["of"]], "answer": "little chance of", "hint": "There is little ___ of + -ing.", "tags": ["transformation", "collocation"]},
  {"first": "Although he tried hard, he failed the exam.", "key": "MATTER", "stem": "No ___, he failed the exam.", "chunks": [["matter how hard"], ["he tried"]], "answer": "matter how hard he tried", "hint": "No matter how + adjective/adverb + clause.", "tags": ["transformation", "linker"]},
  {"first": "Everyone noticed that she wasn't at the meeting.", "key": "CONSPICUOUS", "stem": "She was ___ the meeting.", "chunks": [["conspicuous by"], ["her absence from", "her absence at"]], "answer": "conspicuous by her absence from", "hint": "A fixed phrase about being noticeably missing.", "tags": ["transformation", "idiom"]},
