  {"first": "It's possible that he missed the train.", "key": "MAY", "stem": "He ___ the train.", "chunks": [["may have"], ["missed"]], "answer": "may have missed", "hint": "Modal + perfect infinitive for past speculation.", "tags": ["transformation", "modal"]},
  {"first": "I didn't realise how serious the situation was until I read the report.", "key": "UNTIL", "stem": "Not ___ I realise how serious the situation was.", "chunks": [["until i read"], ["the report did"]], "answer": "until I read the report did", "hint": "Not until … + inversion in the main clause.", "tags": ["transformation", "inversion"]},
